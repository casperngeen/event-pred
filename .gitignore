# Analysis run output — captured stdout and intermediate parquet. Regenerated by
# rerunning the scripts in analysis/*/; the findings themselves are inlined in
# each directory's README.md and in reports/. See analysis/README.md.
out/

# Legacy capture convention, superseded by out/ above. Kept so a stray capture
# written the old way is still ignored rather than silently committed.
*_output.txt
